# Eve model authentication and the structured research reasoner.
OPENAI_API_KEY=
# Alternatively, use an AI Gateway key for the research model.
AI_GATEWAY_API_KEY=
CERES_RESEARCH_MODEL=gpt-5.4
LINKUP_API_KEY=

# Separate Ceres writable storage from project analytics.
CERES_DATABASE_URL=
CERES_MIGRATION_DATABASE_URL=
CERES_OWNER_ID=owner
# Printed by npm run db:seed; UUIDv7, bound server-side.
CERES_WORKSPACE_ID=
# Optional path used only by db:seed (defaults to config/sample.json).
CERES_CONFIG_PATH=

# Required only for sample=false. Use a SELECT-only login on analytics views.
ANALYTICS_DATABASE_URL=
# Single SELECT with $1/$2 period bounds, returning visitor, session, event, group, at.
CERES_ANALYTICS_QUERY=

ROUTE_AUTH_BASIC_USER=ceres
ROUTE_AUTH_BASIC_PASSWORD=
