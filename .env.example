# Server-side Linkup API key used to search the web during research runs.
LINKUP_API_KEY=

# PostgreSQL persistence for insights, research, hypotheses, and workflow state.
# Set this and run npm run db:migrate. Leave empty to use the file store.
DATABASE_URL=

# File-store fallback when DATABASE_URL is unset. Relative paths resolve from the application root.
# On Railway, keep this inside the mounted /app/.eve volume.
CERES_DATA_PATH=.eve/ceres-records.jsonl

# Username and password protecting the deployed Eve HTTP route. Local dev auth
# is also enabled, but production deployments should set a strong password.
ROUTE_AUTH_BASIC_USER=ceres
ROUTE_AUTH_BASIC_PASSWORD=
