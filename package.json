{
  "name": "ceres-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "start": "eve start --host 0.0.0.0",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-transform-types scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --experimental-transform-types scripts/seed.ts"
  },
  "dependencies": {
    "eve": "latest",
    "pg": "^8.23.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "microsandbox": "^0.5.10",
    "typescript": "latest"
  }
}
